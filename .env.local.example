# Sidecar PEP — configuração local (copie para .env.local)

# Segredo compartilhado com o Dataspace (DEVE ser igual ao do dataspaceapp).
# O Dataspace usa este segredo para registrar equipamentos e empurrar tokens.
SIDECAR_ADMIN_SECRET=troque-por-um-segredo-forte

# (opcional) seed de equipamentos legados por variável de ambiente.
# Normalmente os CPS são registrados dinamicamente pelo Dataspace — não precisa.
# EQUIPMENT_CNC_URL=http://192.168.0.70:3001
# EQUIPMENT_PRESS_URL=http://192.168.0.8:3002

# (opcional) webhook para reportar acessos P2P de volta ao Dataspace (rastreabilidade)
# DATASPACE_WEBHOOK_URL=https://<seu-app>.vercel.app/api/sidecar/events
# DATASPACE_WEBHOOK_SECRET=<mesmo do dataspace>
